---
interface Props {
  authed: boolean;
  authRequired: boolean;
}

const { authed, authRequired } = Astro.props;
---

<section id="convert" class="mx-auto max-w-6xl px-6 py-16" data-converter>
  {
    authRequired && !authed && (
      <form
        id="login-form"
        class="border-line bg-canvas mx-auto max-w-md space-y-4 rounded-sm border p-8"
      >
        <h2 class="text-2xl font-extrabold uppercase">Staff sign-in</h2>
        <p class="text-ink-muted font-light">
          Communications set a password for this internal converter.
        </p>
        <label class="block">
          <span class="text-sm font-bold">Password</span>
          <input
            name="password"
            type="password"
            autocomplete="current-password"
            required
            class="border-line mt-2 h-11 w-full rounded-sm border bg-transparent px-3"
          />
        </label>
        <p id="login-error" class="text-sm text-red-700" hidden></p>
        <button
          type="submit"
          class="bg-accent text-canvas hover:bg-accent-dark inline-flex min-h-11 items-center rounded-sm px-5 py-2.5 text-[15px] font-bold"
        >
          Continue
        </button>
      </form>
    )
  }

  <div id="converter-app" class:list={[authRequired && !authed && "hidden"]}>
    <div
      id="dropzone"
      class="border-line bg-canvas focus-within:border-accent hover:border-accent rounded-sm border-2 border-dashed px-6 py-16 text-center transition"
      tabindex="0"
      role="button"
      aria-label="Upload a PowerPoint file"
    >
      <p class="text-accent text-sm font-light tracking-[0.05em] uppercase">
        Step 1
      </p>
      <p class="mt-3 text-2xl font-extrabold uppercase">Drop a .pptx here</p>
      <p class="text-ink-muted mx-auto mt-3 max-w-md font-light">
        Up to 50 MB. Source content is rebuilt onto the Foundation template
        layouts. Charts are recreated as native Office charts (or flagged for
        a manual rebuild). Animations and linked desktop workbooks are not kept.
      </p>
      <input
        id="file-input"
        class="sr-only"
        type="file"
        accept=".pptx,application/vnd.openxmlformats-officedocument.presentationml.presentation"
      />
      <p class="mt-6">
        <label
          for="file-input"
          class="bg-accent text-canvas hover:bg-accent-dark inline-flex min-h-11 cursor-pointer items-center rounded-sm px-5 py-2.5 text-[15px] font-bold"
        >
          Choose file
        </label>
      </p>
      <p id="file-label" class="text-ink-muted mt-4 text-sm"></p>
    </div>

    <fieldset id="colorway" class="border-line mt-8 rounded-sm border p-5">
      <legend class="text-sm font-bold uppercase">Green / Blue</legend>
      <p class="text-ink-muted mt-1 text-sm font-light">
        The 2023 template includes both palette colors. Pick one for this deck.
      </p>
      <div id="colorway-options" class="mt-4 flex flex-wrap gap-6">
        <label class="flex cursor-pointer items-center gap-2 text-sm">
          <input
            type="radio"
            name="colorway"
            value="green"
            checked
            class="accent-accent"
          />
          <span
            ><span class="font-bold">Green</span> — Sawgrass Lime C1D451</span
          >
        </label>
        <label class="flex cursor-pointer items-center gap-2 text-sm">
          <input type="radio" name="colorway" value="blue" class="accent-accent" />
          <span><span class="font-bold">Blue</span> — Water Teal 00ACBF</span>
        </label>
      </div>
    </fieldset>

    <p id="status" class="text-ink-muted mt-6 hidden text-sm" role="status"></p>
    <p id="error" class="mt-6 hidden text-sm text-red-700" role="alert"></p>
    <p id="template-note" class="text-ink-muted mt-4 hidden text-sm"></p>

    <div id="preview" class="mt-12 hidden">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-accent text-sm font-light tracking-[0.05em] uppercase">
            Step 2
          </p>
          <h2 class="mt-2 text-3xl font-extrabold uppercase">Review layouts</h2>
        </div>
        <button
          id="download"
          type="button"
          class="bg-accent text-canvas hover:bg-accent-dark inline-flex min-h-11 items-center rounded-sm px-5 py-2.5 text-[15px] font-bold disabled:cursor-not-allowed disabled:opacity-50"
        >
          Download branded deck
        </button>
      </div>
      <ol id="slides" class="mt-8 grid gap-6 md:grid-cols-2"></ol>
    </div>

    <div id="qa" class="mt-10 hidden">
      <h3 class="text-2xl font-extrabold uppercase">QA flags</h3>
      <ul id="qa-flags" class="mt-3 list-disc space-y-1 pl-5 text-sm"></ul>
      <p id="qa-warnings" class="mt-4 text-sm text-red-700"></p>
      <pre
        id="qa-report"
        class="border-line bg-canvas mt-4 max-h-80 overflow-auto rounded-sm border p-4 text-xs whitespace-pre-wrap"
      ></pre>
    </div>
  </div>
</section>

<script>
  type RoleOption = { id: string; label: string };
  type SlidePreview = {
    index: number;
    title: string;
    subtitle: string;
    bodyPreview: string;
    role: string;
    templateLayoutIndex: number;
    templateLayoutName: string;
    shapeKinds: string[];
    hasImage: boolean;
    hasChart: boolean;
    hasTable: boolean;
    hasSmartArt: boolean;
    flags: string[];
    warnings: string[];
  };
  type ParsePayload = {
    fileName: string;
    slideCount: number;
    roles: RoleOption[];
    layoutMap: Record<string, number>;
    layoutNames: Record<string, string>;
    slides: SlidePreview[];
    templateNotes?: string[];
    colorways?: { id: string; label: string; description?: string }[];
    selectedColorway?: string;
    palette?: { label: string; hex: string }[];
    error?: string;
  };
  type ConvertPayload = {
    error?: string;
    downloadName?: string;
    pptxBase64?: string;
    flags?: string[];
    warnings?: string[];
    reportMarkdown?: string;
    parityDiffs?: { source_index: number }[];
    slideCount?: number;
  };

  const root = document.querySelector("[data-converter]");
  const loginForm = document.getElementById("login-form") as HTMLFormElement | null;
  const app = document.getElementById("converter-app");
  const dropzone = document.getElementById("dropzone");
  const fileInput = document.getElementById("file-input") as HTMLInputElement | null;
  const fileLabel = document.getElementById("file-label");
  const statusEl = document.getElementById("status");
  const errorEl = document.getElementById("error");
  const templateNoteEl = document.getElementById("template-note");
  const preview = document.getElementById("preview");
  const slidesEl = document.getElementById("slides");
  const downloadBtn = document.getElementById("download") as HTMLButtonElement | null;
  const qaBox = document.getElementById("qa");
  const qaFlags = document.getElementById("qa-flags");
  const qaWarnings = document.getElementById("qa-warnings");
  const qaReport = document.getElementById("qa-report");

  let currentFile: File | null = null;
  let roleOptions: RoleOption[] = [];
  let layoutMap: Record<string, number> = {};
  let layoutNames: Record<string, string> = {};
  let chosen: string[] = [];

  function showError(message: string) {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = false;
    errorEl.classList.remove("hidden");
  }

  function clearError() {
    if (!errorEl) return;
    errorEl.textContent = "";
    errorEl.classList.add("hidden");
  }

  function setStatus(message: string | null) {
    if (!statusEl) return;
    if (!message) {
      statusEl.classList.add("hidden");
      statusEl.textContent = "";
      return;
    }
    statusEl.textContent = message;
    statusEl.classList.remove("hidden");
  }

  function selectedColorway() {
    const checked = document.querySelector(
      'input[name="colorway"]:checked',
    ) as HTMLInputElement | null;
    return checked?.value === "blue" ? "blue" : "green";
  }

  function setColorway(id: string) {
    const radios = document.querySelectorAll('input[name="colorway"]') as NodeListOf<HTMLInputElement>;
    for (const radio of radios) {
      radio.checked = radio.value === id;
    }
  }

  function renderColorways(
    colorways: { id: string; label: string; description?: string }[] | undefined,
    selected?: string | null,
  ) {
    const fieldset = document.getElementById("colorway");
    const optionsEl = document.getElementById("colorway-options");
    if (!fieldset || !optionsEl) return;
    fieldset.hidden = false;
    fieldset.classList.remove("hidden");
    const list = (colorways || []).filter((item) => item.id);
    if (list.length >= 2) {
      const chosen =
        selected && list.some((item) => item.id === selected) ? selected : selectedColorway();
      optionsEl.replaceChildren();
      for (const item of list) {
        const label = document.createElement("label");
        label.className = "flex cursor-pointer items-center gap-2 text-sm";
        const input = document.createElement("input");
        input.type = "radio";
        input.name = "colorway";
        input.value = item.id;
        input.className = "accent-accent";
        input.checked = item.id === chosen;
        const text = document.createElement("span");
        const strong = document.createElement("span");
        strong.className = "font-bold";
        strong.textContent = item.label;
        text.append(strong);
        if (item.description) {
          text.append(document.createTextNode(` — ${item.description}`));
        }
        label.append(input, text);
        optionsEl.append(label);
      }
      return;
    }
    if (selected) setColorway(selected);
  }

  function layoutCaption(role: string) {
    const name = layoutNames[role];
    const index = layoutMap[role];
    if (name && index !== undefined) return `${name} (layout ${index})`;
    if (name) return name;
    return role;
  }

  loginForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const loginError = document.getElementById("login-error");
    const data = new FormData(loginForm);
    const response = await fetch("/api/login", { method: "POST", body: data });
    if (!response.ok) {
      const payload = (await response.json()) as { error?: string };
      if (loginError) {
        loginError.hidden = false;
        loginError.textContent = payload.error || "Could not sign in.";
      }
      return;
    }
    loginForm.classList.add("hidden");
    app?.classList.remove("hidden");
  });

  async function readPayload<T extends { error?: string }>(response: Response): Promise<T> {
    const text = await response.text();
    try {
      return JSON.parse(text) as T;
    } catch {
      const clipped = text.replace(/\s+/g, " ").trim().slice(0, 280);
      throw new Error(
        clipped || `Could not read this deck (HTTP ${response.status}).`,
      );
    }
  }

  async function parseFile(file: File) {
    clearError();
    qaBox?.classList.add("hidden");
    if (!file.name.toLowerCase().endsWith(".pptx")) {
      showError("Only .pptx files are supported for the source deck.");
      return;
    }
    currentFile = file;
    if (fileLabel) {
      const kb = Math.max(1, Math.round(file.size / 1024));
      const size =
        file.size >= 1024 * 1024
          ? `${(file.size / 1024 / 1024).toFixed(1)} MB`
          : `${kb} KB`;
      fileLabel.textContent = `${file.name} · ${size}`;
    }
    setStatus("Reading slides…");
    preview?.classList.add("hidden");
    const body = new FormData();
    body.set("file", file);
    body.set("colorway", selectedColorway());
    try {
      const response = await fetch("/api/parse", { method: "POST", body });
      const payload = await readPayload<ParsePayload>(response);
      if (!response.ok) {
        setStatus(null);
        showError(payload.error || "Could not read this deck.");
        return;
      }
      if (!payload.slides?.length) {
        setStatus(null);
        showError("No slides came back from this deck.");
        return;
      }
      roleOptions = payload.roles || [];
      layoutMap = payload.layoutMap || {};
      layoutNames = payload.layoutNames || {};
      chosen = payload.slides.map((slide) => slide.role);
      renderSlides(payload.slides);
      renderColorways(payload.colorways, payload.selectedColorway);
      if (templateNoteEl) {
        const note = payload.templateNotes?.find((item) => !/stand-in|generated starter/i.test(item));
        if (note) {
          templateNoteEl.textContent = note;
          templateNoteEl.classList.remove("hidden");
        } else {
          templateNoteEl.classList.add("hidden");
        }
      }
      const design = selectedColorway();
      setStatus(
        `${payload.slideCount} slides planned · ${design === "blue" ? "Blue (Water Teal)" : "Green (Sawgrass Lime)"}. Adjust roles if needed, then download.`,
      );
      preview?.classList.remove("hidden");
    } catch (error) {
      setStatus(null);
      showError(error instanceof Error ? error.message : "Could not read this deck.");
    }
  }

  function renderSlides(slides: SlidePreview[]) {
    if (!slidesEl) return;
    slidesEl.replaceChildren();
    slides.forEach((slide, index) => {
      const item = document.createElement("li");
      item.className = "border-line bg-canvas overflow-hidden rounded-sm border";
      const badges = [
        slide.hasChart ? "Chart (rebuilt)" : "",
        slide.hasImage ? "Image" : "",
        slide.hasTable ? "Table" : "",
        slide.hasSmartArt ? "SmartArt → bullets" : "",
        ...(slide.flags || []),
      ]
        .filter(Boolean)
        .join(" · ");
      const select = roleOptions
        .map(
          (role) =>
            `<option value="${role.id}" ${role.id === chosen[index] ? "selected" : ""}>${role.label}</option>`,
        )
        .join("");
      item.innerHTML = `
        <div class="bg-marsh h-2"></div>
        <div class="space-y-3 p-5">
          <p class="text-accent text-xs font-light tracking-[0.08em] uppercase">Slide ${index + 1}</p>
          <p class="font-extrabold uppercase">${escapeHtml(slide.title || slide.bodyPreview.split("\n")[0] || "Untitled")}</p>
          <p class="text-ink-muted line-clamp-4 text-sm">${escapeHtml(slide.bodyPreview || "")}</p>
          ${badges ? `<p class="text-sm font-bold">${escapeHtml(badges)}</p>` : ""}
          ${slide.warnings?.length ? `<p class="text-sm text-red-700">${escapeHtml(slide.warnings.join(" "))}</p>` : ""}
          <label class="block text-sm">
            <span class="font-bold">Layout role</span>
            <select data-index="${index}" class="border-line mt-2 h-11 w-full rounded-sm border bg-transparent px-3">${select}</select>
          </label>
          <p class="text-ink-muted text-xs" data-layout-caption>${escapeHtml(layoutCaption(chosen[index]))}</p>
        </div>
      `;
      const control = item.querySelector("select");
      const caption = item.querySelector("[data-layout-caption]");
      control?.addEventListener("change", () => {
        chosen[index] = control.value;
        if (caption) caption.textContent = layoutCaption(control.value);
      });
      slidesEl.append(item);
    });
  }

  function escapeHtml(value: string) {
    return value
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;");
  }

  dropzone?.addEventListener("click", (event) => {
    if ((event.target as HTMLElement).closest("label")) return;
    fileInput?.click();
  });
  dropzone?.addEventListener("keydown", (event) => {
    if (event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      fileInput?.click();
    }
  });
  dropzone?.addEventListener("dragover", (event) => {
    event.preventDefault();
    dropzone.classList.add("border-accent");
  });
  dropzone?.addEventListener("dragleave", () => {
    dropzone.classList.remove("border-accent");
  });
  dropzone?.addEventListener("drop", (event) => {
    event.preventDefault();
    dropzone.classList.remove("border-accent");
    const file = event.dataTransfer?.files[0];
    if (file) void parseFile(file);
  });
  fileInput?.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) void parseFile(file);
  });
  document.getElementById("colorway")?.addEventListener("change", (event) => {
    const target = event.target as HTMLInputElement | null;
    if (target?.name === "colorway" && currentFile) void parseFile(currentFile);
  });

  downloadBtn?.addEventListener("click", async () => {
    if (!currentFile) return;
    clearError();
    downloadBtn.disabled = true;
    const colorway = selectedColorway();
    setStatus(
      `Rebuilding onto the Everglades ${colorway === "blue" ? "Blue (Water Teal)" : "Green (Sawgrass Lime)"} colorway and running QA…`,
    );
    qaBox?.classList.add("hidden");
    const body = new FormData();
    body.set("file", currentFile);
    body.set("colorway", colorway);
    body.set(
      "plan",
      JSON.stringify(
        chosen.map((role, source_index) => ({ source_index, role })),
      ),
    );
    try {
      const response = await fetch("/api/convert", { method: "POST", body });
      const payload = (await response.json()) as ConvertPayload;
      if (!response.ok) {
        showError(payload.error || "Conversion failed.");
        setStatus(null);
        return;
      }
      const headerFlags = response.headers.get("X-QA-Flags");
      const headerWarnings = response.headers.get("X-Conversion-Warnings");
      const flags = payload.flags?.length
        ? payload.flags
        : headerFlags
          ? (JSON.parse(decodeURIComponent(headerFlags)) as string[])
          : [];
      const warnings = payload.warnings?.length
        ? payload.warnings
        : headerWarnings
          ? (JSON.parse(decodeURIComponent(headerWarnings)) as string[])
          : [];
      if (payload.pptxBase64) {
        const binary = Uint8Array.from(atob(payload.pptxBase64), (ch) => ch.charCodeAt(0));
        const blob = new Blob([binary], {
          type: "application/vnd.openxmlformats-officedocument.presentationml.presentation",
        });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = payload.downloadName || "everglades.pptx";
        link.click();
        URL.revokeObjectURL(url);
      }
      if (qaFlags) {
        qaFlags.replaceChildren();
        const items = flags.length ? flags : ["none"];
        for (const flag of items) {
          const li = document.createElement("li");
          li.textContent = flag;
          qaFlags.append(li);
        }
      }
      if (qaWarnings) {
        const extra = payload.parityDiffs?.length
          ? `${payload.parityDiffs.length} text-parity diff(s).`
          : "";
        qaWarnings.textContent = [...warnings, extra].filter(Boolean).join(" ");
      }
      if (qaReport) qaReport.textContent = payload.reportMarkdown || "";
      qaBox?.classList.remove("hidden");
      setStatus(
        `Download started (${payload.slideCount ?? "?"} slides, ${colorway === "blue" ? "Blue (Water Teal)" : "Green (Sawgrass Lime)"}). Review QA flags below before circulating the deck.`,
      );
    } catch (error) {
      showError(error instanceof Error ? error.message : "Conversion failed.");
      setStatus(null);
    } finally {
      downloadBtn.disabled = false;
    }
  });

  void root;
</script>
