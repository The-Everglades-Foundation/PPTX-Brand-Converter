---
import Layout from "../layouts/Layout.astro";
import Converter from "../components/Converter.astro";

const { authed, authRequired } = Astro.locals;
---

<Layout>
  <section class="border-line border-b">
    <div class="mx-auto max-w-6xl px-6 py-16 lg:py-24">
      <p class="text-accent mb-6 text-sm font-light tracking-[0.05em] uppercase">
        Internal staff tool
      </p>
      <h1 class="max-w-3xl text-5xl leading-none font-extrabold uppercase sm:text-6xl">
        Rebuild any deck on the 2026 Everglades template.
      </h1>
      <p class="text-ink-muted mt-6 max-w-xl text-lg font-light tracking-[0.05em]">
        Titles, bullets, images, tables, notes, and charts are lifted from the
        file you upload and rebuilt on Foundation layouts. Charts become new
        native Office charts on the template (unsupported or Excel-linked charts
        are rasterized and flagged). Animations are not kept.
      </p>
    </div>
  </section>
  <Converter authed={authed} authRequired={authRequired} />
</Layout>
